PORT=4000

# Single-device fallback, used when Supabase (the `devices` table) is not
# configured or reachable. DEVICE_BASE_URL should be the ESP32's mDNS name
# (see esp32/README.md) or a static local IP.
DEVICE_ID=esp32-bin-001
DEVICE_BASE_URL=http://esp32-bin-001.local

# Optional - leave both unset to run fully local-only (no history, no
# persisted alerts, no multi-device registry).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGIN=http://localhost:5173
